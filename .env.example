# PLANTILLA — este archivo SÍ se sube al repo. Nunca pongas credenciales acá.
#
# Copialo como `.env` y completá los valores ahí:
#   cp .env.example .env
#
# `.env` está en .gitignore y no se sube. Los mismos dos valores van cargados
# como Secrets en GitHub Actions (Settings -> Secrets and variables -> Actions).

# Lo da @BotFather al crear el bot. Formato: 123456789:AAF-xxxxxxxxxxxxxxxxx
TELEGRAM_TOKEN=

# Tu chat con el bot. Se saca de:
#   https://api.telegram.org/bot<TU_TOKEN>/getUpdates
# y es el campo result[0].message.chat.id
TELEGRAM_CHAT_ID=
