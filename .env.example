# TEMPLATE — this file IS committed to the repo. Never put credentials here.
#
# Copy it as `.env` and fill in the values there:
#   cp .env.example .env
#
# `.env` is in .gitignore and isn't committed. The same two values go loaded as
# Secrets in GitHub Actions (Settings -> Secrets and variables -> Actions).

# Given by @BotFather when you create the bot. Format: 123456789:AAF-xxxxxxxxxxxxxxxxx
TELEGRAM_TOKEN=

# Your chat with the bot. You get it from:
#   https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates
# and it's the result[0].message.chat.id field
TELEGRAM_CHAT_ID=
